{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traductor de Documentos - Ingles a Espanol",
  "version": "1.0.0",
  "identifier": "com.victoriasanjurjo.traductordocumentosenes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Traductor de Documentos - Inglés a Español (v1.0.0)",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
