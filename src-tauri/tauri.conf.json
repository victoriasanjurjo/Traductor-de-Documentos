{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traducir textos ingles a espanol",
  "version": "1.0.0",
  "identifier": "com.victoriasanjurjo.traducirtextosenes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Traducir textos inglés a español (v1.0.0)",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
